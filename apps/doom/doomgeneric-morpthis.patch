+//
+// Z_Shutdown
+//
+// Releases the whole zone. A port that unloads Doom without exiting the
+// process (a plugin) calls this after the game has stopped.
+//
+void Z_Shutdown (void)
+{
+    if (mainzone != NULL)
+    {
+        free(mainzone);
+        mainzone = NULL;
+    }
+}
